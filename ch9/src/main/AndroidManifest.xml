<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--    user-permission은 권한과 관련되어있다.-->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!--   permission보다 빈번하진 않지만 uses-feature 사용된다. 권한과 관련되어 있다.
     하드웨어의 요구사항이기 때문이다.
     내 앱에서 이런 하드웨어를 사용할 것이다. 선언하는 것이다.
     유저 디바이스에 이용하는 하드웨어가 있어야 한다는 조건을 명시한다는 것이다.
     앱을 만드는데 카메라를 극한으로 사용하는 서비스 앱을 만들었다. 어떤 유저가 앱을 다운로드 받아서 하려고 하는데 유저 디바이스에 카메라가 없다?
     전화를 걸면 telephony라는 하드웨어 요구사항이 있도록 한다.

     대표적인 것은 : telephony, camera ...
     required : true -> play store에서 필터링 해서 아래 하드웨어가 없는 폰에는 앱이 노출되지 않게 할 수 있다.-->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidLab2">
        <activity
            android:name=".Test3Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SomeActivity"
            android:exported="false" />
        <activity
            android:name=".Test2Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Sub4Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="ACTION_SUB4" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="http" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Sub3Activity"
            android:exported="true">
            <intent-filter>

                <!--
                action, category, data 어느것을 추가할지는 개발자 임의의 선택이다.
                선언되어 있으면 모두 맞추어야 한다.
                action이 여러개, category도 여러개, data 여러개를 넣는게 가능하다.
                그 중에서 하나만 맞으면 된다.
                -->
                <action android:name="ACTION_SUB3" />

                <category android:name="android.intent.category.DEFAULT" />

                <!-- name에 패키지명을 추가하는 것이 권장 사항이다. -->
                <category android:name="com.example.ch9.CATEGORY_SUB3" />
            </intent-filter>
        </activity> <!-- Sub2Activity는 명시적으로도 되지만 암시적 테스트를 위해서 -->
        <activity
            android:name=".Sub2Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="ACTION_SUB2" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity> <!-- Sub1Activity는 명시적으로 intent전달 예정 -->
        <activity
            android:name=".Sub1Activity"
            android:exported="false" />
        <activity
            android:name=".Test1Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>